// further modified by various authors

//
// worldspawn
//

@SolidClass = worldspawn : "World entity"
[
	message(string) : "Text on entering the world"
	worldtype(choices) : "Ambience" : 0 =
	[
		0 : "Medieval"
		1 : "Metal (runic)"
		2 : "Base"
	]
	sounds(integer) : "CD track to play" : 0
	light(integer) : "Ambient light"
	_sunlight(integer) : "Sunlight"
	_sun_mangle(string) : "Sun mangle (Yaw pitch roll)"
]

//
// base marker definitions
//

@baseclass = Angle [ angle(integer) : "Direction" ]

@baseclass = Appearflags [
	spawnflags(Flags) =
	[
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
]

@baseclass = Targetname [ targetname(target_source) : "Name" ]
@baseclass = Target [
	target(target_destination) : "Target"
	killtarget(target_destination) : "Killtarget"
]



//
// player starts, deathmatch, coop, teleport
//

@baseclass base(Appearflags) size(-16 -16 -24, 16 16 32)
	color(0 255 0) model({ "path": ":progs/player.mdl" }) = PlayerClass []

@PointClass base(PlayerClass) = info_player_start : "Player 1 start" []
@PointClass base(PlayerClass) = info_player_coop : "Player cooperative start" []
@PointClass base(PlayerClass) = info_player_start2 : "Player episode return point" []
@PointClass base(PlayerClass) = info_player_deathmatch : "Deathmatch start" []
@PointClass base(PlayerClass) = testplayerstart : "Testing player start" []
@PointClass size(-32 -32 0, 32 32 64) base(PlayerClass, Targetname) = info_teleport_destination : "Teleporter destination" []
@PointClass color(200 150 150) = info_null : "info_null (spotlight target)"
[
	targetname(target_source) : "Name"
]

@PointClass base(Appearflags, Target, Targetname) color(200 150 150) = info_notnull : "Wildcard entity" // I love you
[
	use(string) : "self.use"
	think(string) : "self.think"
	nextthink(integer) : "nextthink"
	noise(string) : "noise"
	touch(string) : "self.touch"
]
@PointClass base(Appearflags) = info_intermission : "Intermission camera"
[
	mangle(string) : "Camera angle (Pitch Yaw Roll)"
]

@PointClass base(Appearflags) = info_slender : "Slender Man's spawn point" []

//---- MOD Rev2 29/octubre/2026
// item spots: added sm_itemspot_id (read by SM_Event_Randomize_Item), removed the duplicated info_key_spot
@baseclass = ItemSpot
[
	sm_itemspot_id(integer) : "Spot group ID" : 0 : "Spots that share an ID form one group. Each group shows at most one item, picked at random. Give every spot a unique ID unless the spots are alternatives for the same item."
]
@PointClass base(Appearflags, ItemSpot) = info_key_spot : "Key spawn point" []
@PointClass base(Appearflags, ItemSpot) = info_memento_spot : "Memento spawn point" []
@PointClass base(Appearflags, ItemSpot) = info_page_spot : "Page spawn point" []

//---- MOD Rev2 29/octubre/2026
// event_manager: keys added from event_manager() and SM_Event_*, base(Targetname) removed because the code forces it
@PointClass = event_manager : "Event manager

Runs the Slender gameplay loop: page music, collectibles, keys, aggression and Slender Man spawning. Use one per map. Removed in deathmatch. Its targetname is always set to sm_event_manager.

Pages, mementos and keys are created from info_page_spot, info_memento_spot and info_key_spot. Slender Man spawns at a random info_slender: 1 on Easy and Normal, 2 on Hard, 4 on Nightmare, always 1 with the Weeping Angel AI. The Weeping Angel AI waits for the first collectible before it spawns and before aggression starts.

Aggression = (collectibles * count + keys * cnt + failed door attempts * frags) * skill multiplier + passive aggression, clamped to 1..armorvalue. Skill multiplier: 0.5 Easy, 1 Normal, 1.25 Hard, 1.5 Nightmare. A non-zero cvar scratch1 overrides it (clamped to 0.5..2).

While an event_manager exists, touching any func_door runs the Slender key door logic instead of the gold and silver key flags (see func_door key_targetname)."
[
	wait(integer) : "Collectibles needed on Easy and Normal" : 0 : "Applies to pages and to mementos. If 0, the code counts the item_page entities present when event_manager spawns, capped at 8. Pages are created later from info_page_spot, so that count is normally 0 and no collectibles appear. Set this key."
	dmg(integer) : "Collectibles needed on Hard and Nightmare" : 10
	distance(integer) : "Keys needed on Easy and Normal" : 0
	volume(integer) : "Keys needed on Hard and Nightmare" : 0
	sounds(choices) : "Page music set" : 1 =
	[
		1 : "Eight Pages (4-step progression)"
		2 : "7th Street (6-step progression)"
		3 : "Prison (6-step progression)"
	]
	weapon(integer) : "Tracks in the music set" : 4 : "Used together with sounds to offset the CD track numbers of the set."
	style(choices) : "Slender Man AI style" : 0 =
	[
		0 : "Eight Pages"
		1 : "Slender Man's Shadow"
		2 : "Weeping Angel (Prison)"
	]
	armorvalue(integer) : "Maximum aggression" : 0 : "If 0: 8 with the Eight Pages AI (10 on Hard and Nightmare), 100 with the other AI styles (120 on Hard and Nightmare)."
	count(integer) : "Aggression per collectible" : 1
	cnt(integer) : "Aggression per key" : 0
	frags(integer) : "Aggression per failed door attempt" : 0 : "Counted each time a player touches a func_door without the matching key."
	delay(integer) : "Passive aggression interval (seconds)" : 300 : "Seconds of play with active players between passive aggression increases."
	ltime(integer) : "Passive aggression per interval" : 1
]

